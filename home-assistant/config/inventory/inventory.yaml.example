# 기기 인벤토리 — PRD §4.2 체크리스트를 YAML 스키마로 옮긴 것.
# 이 파일 자체는 HA가 직접 읽지 않는다(HA 엔티티는 통합에서 자동 생성됨).
# 대신 이 문서가 "무엇을 어떤 방식으로 연동할지" 결정하는 단일 소스이며,
# 아래 각 항목의 room/domain 값이 packages/*.yaml 의 entity_id 명명 규칙과
# dashboards/ui-lovelace.yaml 의 방별 뷰 구성 기준이 된다(FR-04, NFR-41).
#
# 사용법: 실제 기기마다 한 항목씩 채워 inventory.yaml 로 저장(Git 커밋 가능,
# 자격증명은 포함하지 않으므로 secrets.yaml 과 달리 버전 관리 대상).

devices:
  - id: living_room_curtain # 예시 — 오픈 이슈 Q1: 브랜드/모델 확인 전 placeholder
    brand: unknown # [확인 필요: Q1] 커튼 제조사
    model: unknown # [확인 필요: Q1]
    room: living_room
    domain: cover
    comm: [ble, wifi] # 확정(§4.1, §4.3)
    integration_path: C4_ble_local # C3(wifi_local화) | C4(ble_local) | C7(smartthings) — Q1 확인 후 확정
    local_or_cloud: L # 잠정. BLE 로컬 검증 실패 시 C로 재분류(IR-07)
    matter_qr: false
    firmware: unknown
    connected_hub: unknown # 기존 SmartThings 등록 여부 확인 필요(4.3 C7)
    required_automations: [S1_away, S3_sleep, S4_morning_curtain]
    safety_tier: low
    static_ip_or_reservation: false
    power_monitoring_needed: false

  - id: living_room_samsung_tv
    brand: samsung
    model: unknown # [확인 필요: Q3]
    room: living_room
    domain: media_player
    comm: [wifi_lan]
    integration_path: samsungtv_local
    local_or_cloud: L
    matter_qr: false
    firmware: unknown
    connected_hub: null
    required_automations: [S1_away, S12_movie_mode]
    safety_tier: low
    static_ip_or_reservation: true
    power_monitoring_needed: false

  - id: smartthings_station
    brand: samsung
    model: unknown # [확인 필요: Q4] Thread/Matter BR 지원 세대인지
    room: utility
    domain: hub
    comm: [zigbee, thread_maybe, wifi]
    integration_path: matter_multiadmin_or_smartthings_api
    local_or_cloud: L/C
    matter_qr: unknown
    firmware: unknown
    connected_hub: null
    required_automations: []
    safety_tier: n/a
    static_ip_or_reservation: true
    power_monitoring_needed: false
    notes: >
      보유 확정(§4.1, §9.2). Zigbee 라디오는 벤더 종속이라 HA가 직접 재사용 불가(§10).
      Thread BR 재사용 가능 여부는 세대 확인 후 결정.

  - id: nest_hub
    brand: google
    model: unknown # [확인 필요: Q4] Nest Hub 2세대 여부가 Thread BR 보유를 가름
    room: living_room
    domain: media_player
    comm: [wifi, thread_maybe]
    integration_path: cast_local
    local_or_cloud: L
    matter_qr: unknown
    firmware: unknown
    connected_hub: null
    required_automations: [S5_appliance_done_tts, S10_voice_coexist]
    safety_tier: n/a
    static_ip_or_reservation: false
    power_monitoring_needed: false

  - id: wall_tablet
    brand: unknown # [확인 필요: Q2]
    model: unknown # [확인 필요: Q2]
    room: entrance # 설치 위치 확인 필요
    domain: kiosk_display
    comm: [wifi]
    integration_path: ha_companion_app_kiosk
    local_or_cloud: L
    os: android # 확정
    required_automations: [UX-06_screen_saver, UX-11_tablet_as_device]
    safety_tier: n/a
    static_ip_or_reservation: true
    power_monitoring_needed: true # UX-02 배터리 보호

# 항목을 추가할 때마다 domain 값은 packages/scenes_core.yaml, automations_core.yaml
# 의 그룹(group.*) 정의와 dashboards/ui-lovelace.yaml 의 카드 목록에도 반영해야 한다.
