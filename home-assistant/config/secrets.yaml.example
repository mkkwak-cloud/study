# 실제 값 채운 뒤 secrets.yaml 로 복사한다. secrets.yaml 은 .gitignore 대상이며
# 절대 Git에 커밋하지 않는다 (NFR-20).

home_latitude: 0.0
home_longitude: 0.0
home_elevation: 0

mqtt_broker_host: localhost
mqtt_username: change_me
mqtt_password: change_me

# 아래 토큰들은 HA UI의 OAuth/PAT 등록 플로우에서 요구할 때 채운다.
# - SmartThings: Personal Access Token 은 상시 연동에 쓰지 않는다(NFR-21). OAuth 앱 등록 필요.
# - LG ThinQ Connect PAT: https://connect-pat.lgthinq.com
# - Google SDM API: OAuth client id/secret + Device Access 프로젝트 등록
thinq_pat: change_me
google_sdm_client_id: change_me
google_sdm_client_secret: change_me
google_sdm_project_id: change_me
