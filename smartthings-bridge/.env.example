# SmartThings Developer Workspace(https://developer.smartthings.com/workspace)
# 에서 "API 전용 앱"(OAuth-in) 등록 후 발급받는 값. SETUP.md 참고.

SMARTTHINGS_CLIENT_ID=change_me
SMARTTHINGS_CLIENT_SECRET=change_me

# OAuth 앱 등록 시 입력한 Redirect URI와 정확히 일치해야 한다.
SMARTTHINGS_REDIRECT_URI=http://localhost:4310/auth/callback

# 이 서버 자체의 포트
PORT=4310

# tablet-ui 등 프런트엔드에서의 요청만 허용하기 위한 CORS origin
ALLOWED_ORIGIN=http://localhost:5173
